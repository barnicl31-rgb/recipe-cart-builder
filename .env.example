PORT=3000

# Swiggy MCP Instamart endpoint.
SWIGGY_MCP_ENDPOINT=https://mcp.swiggy.com/im

# Temporary local development token.
# Get this through Swiggy OAuth/MCP client auth. Do not commit real tokens.
SWIGGY_TOKEN=

# Production OAuth callback registered with Swiggy.
SWIGGY_REDIRECT_URI=https://recipe-basket-builder.vercel.app/auth/callback

# Generate a random value of at least 32 characters for Vercel.
# This encrypts OAuth state and the extension's sealed Swiggy session.
SWIGGY_SESSION_SECRET=
